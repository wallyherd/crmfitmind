# Copie para .env e preencha. O .env nunca vai para o Git.

# Endereço do CRM (só a origem, https). Fixo: o gateway não aceita trocar isso pela rede.
CRM_BASE=https://crm-fitmind-whatsapp.vercel.app

# Segredo das assinaturas HMAC. Gere com:  openssl rand -hex 32
# O MESMO valor vai na Vercel, na variável GATEWAY_SECRET do CRM.
GATEWAY_SECRET=

# Subdomínio que aponta para o IP deste VPS (registro A). O Caddy tira o certificado sozinho.
# Na Vercel, GATEWAY_URL=https://<este domínio>   (sem barra e sem caminho no fim)
GATEWAY_DOMINIO=gw.exemplo.com.br

# Heap de cada sessão em MB (padrão 512 por causa do 1º histórico). Medir no piloto.
# SESSAO_MEMORIA_MB=512
