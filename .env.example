# Copie para .env (local) ou cadastre no painel da Vercel. Nunca commite valores reais.

# ---- Servidor (api/ e server/) ----
# URL do projeto Supabase do CRM
SUPABASE_URL=https://seu-projeto.supabase.co
# Chave secreta (service role / sb_secret_). Só no servidor, nunca no navegador.
SUPABASE_SERVICE_ROLE_KEY=
# Origens que podem chamar a API pelo navegador, separadas por vírgula
APP_ORIGIN=https://crm-fitmind-whatsapp.vercel.app,http://localhost:5173
# Segredo compartilhado com o gateway de WhatsApp (assinatura HMAC dos pedidos)
GATEWAY_SECRET=
# Endereço do gateway no VPS, para a nuvem "acordar" o gateway (POST {GATEWAY_URL}/acordar)
GATEWAY_URL=
# ---- IA das Fases 2 e 3 ----
# Chave da API da Anthropic (a do Erick, nos Termos Comerciais). Só no servidor. Sem ela o motor api_batch não roda.
ANTHROPIC_API_KEY=
# Modelo da API Batch. Padrão claude-sonnet-5-5; aceita claude-haiku-4-5 (mais barato, menos preciso).
IA_MODELO=claude-sonnet-5-5
# Modelo que lê os comprovantes (imagem/PDF) e extrai valor, data, banco e ID da transação. Padrão claude-haiku-4-5 (barato).
# IA_MODELO_COMPROVANTE=claude-haiku-4-5
# Máximo de comprovantes lidos por execução do cron (a cada 15 min). Padrão 10.
# IA_COMPROVANTES_POR_EXECUCAO=10
# Segredo das rotas /api/cron/* (o pg_cron manda em Authorization: Bearer). Gere um valor longo e aleatório.
CRON_SECRET=

# ---- Front (Vite; entra no JavaScript público) ----
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
# Chave pública (anon / sb_publishable_). A RLS é que protege os dados.
VITE_SUPABASE_ANON_KEY=

# ---- Só no desenvolvimento local ----
# Porta do servidor (npm run server); o Vite redireciona /api para ela
PORT=3000
